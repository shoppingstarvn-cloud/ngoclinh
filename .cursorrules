        "lazada": os.getenv("LAZADA_AFFILIATE_URL_TECH", "https://www.lazada.vn/catalog/?q=cÃ´ng+nghá»‡"),
        "ten": "Sáº£n pháº©m cÃ´ng nghá»‡ hot"
    },
    "Ä‘á»“ Äƒn": {
        "shopee": os.getenv("SHOPEE_AFFILIATE_URL_FOOD", "https://shopee.vn/search?keyword=Ä‘á»“+Äƒn"),
        "lazada": os.getenv("LAZADA_AFFILIATE_URL_FOOD", "https://www.lazada.vn/catalog/?q=Ä‘á»“+Äƒn"),
        "ten": "Äá»“ Äƒn & áº©m thá»±c"
    },
    "gia dá»¥ng": {
        "shopee": os.getenv("SHOPEE_AFFILIATE_URL_HOME", "https://shopee.vn/search?keyword=Ä‘á»“+gia+dá»¥ng"),
        "lazada": os.getenv("LAZADA_AFFILIATE_URL_HOME", "https://www.lazada.vn/catalog/?q=Ä‘á»“+gia+dá»¥ng"),
        "ten": "Äá»“ gia dá»¥ng thÃ´ng minh"
    },
    "thÃº cÆ°ng": {
        "shopee": os.getenv("SHOPEE_AFFILIATE_URL_PET", "https://shopee.vn/search?keyword=Ä‘á»“+thÃº+cÆ°ng"),
        "lazada": os.getenv("LAZADA_AFFILIATE_URL_PET", "https://www.lazada.vn/catalog/?q=thÃº+cÆ°ng"),
        "ten": "Phá»¥ kiá»‡n thÃº cÆ°ng"
    },
    "sá»©c khá»e": {
        "shopee": os.getenv("SHOPEE_AFFILIATE_URL_HEALTH", "https://shopee.vn/search?keyword=sá»©c+khá»e"),
        "lazada": os.getenv("LAZADA_AFFILIATE_URL_HEALTH", "https://www.lazada.vn/catalog/?q=sá»©c+khá»e"),
        "ten": "Sáº£n pháº©m sá»©c khá»e"
    },
    "default": {
