### SCRIPT 3: hermes_pipeline_v6.py
**Chá»©c nÄƒng:** Tá»« chá»§ Ä‘á» â†’ video hoÃ n chá»‰nh. Thumbnail dÃ¹ng Pillow (thay Canva API)

```python
#!/usr/bin/env python3
# hermes_pipeline_v6.py â€” Tá»« chá»§ Ä‘á» â†’ video. Pillow thumbnail, khÃ´ng Canva API
# Crontab: 0 7,14 * * * source /root/nexus/.env && python3 hermes_pipeline_v6.py

import asyncio, edge_tts, json, os, time, requests, random
from PIL import Image, ImageDraw, ImageFont
from moviepy.editor import ImageClip, AudioFileClip, TextClip, CompositeVideoClip
from hermes_affiliate import lay_link_affiliate

API_KEY      = os.getenv("ANTHROPIC_API_KEY")
TG_TOKEN     = os.getenv("TELEGRAM_BOT_TOKEN")
TG_CHAT      = os.getenv("TELEGRAM_CHAT_ID")
ANH_NEN_DIR  = "/root/nexus/anh_nen"
VIDEO_OUT    = "/root/nexus/video_output"
VOICES       = ["vi-VN-HoaiMyNeural", "vi-VN-NamMinhNeural"]

def tg(msg):
    try:
        requests.post(f"https://api.telegram.org/bot{TG_TOKEN}/sendMessage",
                      json={"chat_id": TG_CHAT, "text": f"ðŸ¤– HERMES: {msg}"}, timeout=10)
    except: pass

def tao_thumbnail_pillow(tieu_de: str, output_path: str):
    """
    Táº¡o thumbnail 1080x1920 báº±ng Pillow â€” khÃ´ng cáº§n Canva API
    Ná»n gradient + text overlay chuyÃªn nghiá»‡p
    """
    W, H = 1080, 1920
    img = Image.new("RGB", (W, H), color=(15, 15, 35))  # Ná»n tá»‘i máº·c Ä‘á»‹nh
    draw = ImageDraw.Draw(img)

    # Gradient ná»n: nhiá»u mÃ u ngáº«u nhiÃªn cho Ä‘a dáº¡ng
    palettes = [
        [(15,15,35), (50,0,80)],    # TÃ­m Ä‘Ãªm
        [(0,20,40), (0,80,120)],    # Xanh biá»ƒn
        [(40,0,0), (120,20,20)],    # Äá» tá»‘i
        [(10,30,10), (20,100,40)],  # Xanh lÃ¡
    ]
    c1, c2 = random.choice(palettes)
    for y in range(H):
        ratio = y / H
        r = int(c1[0] + (c2[0]-c1[0]) * ratio)
        g = int(c1[1] + (c2[1]-c1[1]) * ratio)
        b = int(c1[2] + (c2[2]-c1[2]) * ratio)
        draw.line([(0,y),(W,y)], fill=(r,g,b))

    # Thá»­ dÃ¹ng áº£nh ná»n náº¿u cÃ³
    anh_files = [f for f in os.listdir(ANH_NEN_DIR) if f.endswith((".jpg",".jpeg",".png"))]
    if anh_files:
        try:
            bg = Image.open(os.path.join(ANH_NEN_DIR, random.choice(anh_files)))
            bg = bg.resize((W, H), Image.LANCZOS)
            bg.putalpha(180)  # LÃ m má» 70%
            img.paste(bg, (0,0), bg.convert("RGBA"))
            draw = ImageDraw.Draw(img)
        except: pass

    # Text overlay
    try:
        font_big = ImageFont.truetype("/usr/share/fonts/truetype/dejavu/DejaVuSans-Bold.ttf", 72)
        font_small = ImageFont.truetype("/usr/share/fonts/truetype/dejavu/DejaVuSans.ttf", 48)
    except:
        font_big = ImageFont.load_default()
        font_small = font_big

    # Banner gradient phÃ­a trÃªn
    for y in range(300):
        alpha = int(200 * (1 - y/300))
        draw.line([(0,y),(W,y)], fill=(0,0,0,alpha) if hasattr(draw,'_image') else (0,0,0))

    # Wrap text
    words = tieu_de.split()
    lines, line = [], []
    for w in words:
        test = " ".join(line + [w])
        bbox = draw.textbbox((0,0), test, font=font_big)
        if bbox[2] - bbox[0] > W - 80:
            if line: lines.append(" ".join(line))
            line = [w]
        else:
            line.append(w)
    if line: lines.append(" ".join(line))

    # Váº½ text chÃ­nh (giá»¯a mÃ n hÃ¬nh)
    total_h = len(lines) * 90
    start_y = (H - total_h) // 2
    for i, ln in enumerate(lines):
        bbox = draw.textbbox((0,0), ln, font=font_big)
        x = (W - (bbox[2]-bbox[0])) // 2
        y = start_y + i * 90
        # Shadow
        draw.text((x+3, y+3), ln, font=font_big, fill=(0,0,0,200))
        # Main text
        draw.text((x, y), ln, font=font_big, fill=(255,255,255))

    # Watermark Nexus AI
    draw.text((W-200, H-80), "NEXUS AI", font=font_small, fill=(255,255,255,128))

    img.save(output_path, "JPEG", quality=95)
    return output_path

async def viet_kich_ban(ten, hook_goi_y="", san_pham=""):
    r = requests.post("https://api.anthropic.com/v1/messages",
        headers={"x-api-key": API_KEY, "anthropic-version": "2023-06-01",
                 "content-type": "application/json"},
        json={"model": "claude-sonnet-4-6", "max_tokens": 700,
              "messages": [{"role": "user", "content": f"""
Viáº¿t ká»‹ch báº£n TikTok/Shorts 30â€“45 giÃ¢y vá» "{ten}".
{f'Hook gá»£i Ã½: {hook_goi_y}' if hook_goi_y else ''}
{f'Sáº£n pháº©m affiliate: {san_pham}' if san_pham else ''}

CÃ´ng thá»©c AIDA báº¯t buá»™c:
1. HOOK 3 giÃ¢y Ä‘áº§u: CÃ¢u má»Ÿ Ä‘áº§u gÃ¢y sá»‘c / tÃ² mÃ² cá»±c máº¡nh
2. Váº¤N Äá»€: NÃªu Ä‘Ãºng ná»—i Ä‘au/mong muá»‘n cá»§a ngÆ°á»i xem
3. GIáº¢I PHÃP: Giá»›i thiá»‡u thÃ´ng tin/sáº£n pháº©m tá»± nhiÃªn
4. CTA: "Link sáº£n pháº©m trong bio â€” mÃ¬nh Ä‘á»ƒ dÆ°á»›i Ä‘Ã³ rá»“i nhÃ©!"

Giá»ng thÃ¢n thiá»‡n, gáº§n gÅ©i nhÆ° ngÆ°á»i báº¡n. Chá»‰ xuáº¥t script Ä‘á»c, khÃ´ng tiÃªu Ä‘á», khÃ´ng giáº£i thÃ­ch.
"""}]}, timeout=25)
    return r.json()["content"][0]["text"].strip()

async def tao_giong_doc(script, output):
    voice = random.choice(VOICES)
    await edge_tts.Communicate(script, voice).save(output)

def ghep_video(thumbnail_path, audio, output, tieu_de, caption_bio=""):
    aud = AudioFileClip(audio)
    dur = aud.duration
    vid = ImageClip(thumbnail_path).set_duration(dur)

    cta_text = "ðŸ›’ Link sáº£n pháº©m trong Bio!"
    cta = TextClip(cta_text, fontsize=38, color="yellow",
                   stroke_color="black", stroke_width=2,
                   size=(980, None), method="caption")\
          .set_position(("center", 1750)).set_duration(dur)

    CompositeVideoClip([vid, cta]).set_audio(aud)\
        .write_videofile(output, fps=30, codec="libx264",
                         audio_codec="aac", logger=None)

async def xu_ly_mot_video(chu_de_obj):
    ts   = int(time.time())
    ten  = chu_de_obj.get("ten", "Video hÃ´m nay")
    hook = chu_de_obj.get("hook_goi_y", "")
    aff  = chu_de_obj.get("affiliate", {})
    sp   = aff.get("ten_san_pham", "")
    bio  = aff.get("caption_bio", "")

    tg(f"ðŸŽ¬ Báº¯t Ä‘áº§u: {ten}")
    script = await viet_kich_ban(ten, hook, sp)

    mp3 = f"{VIDEO_OUT}/audio_{ts}.mp3"
    await tao_giong_doc(script, mp3)

    thumbnail = f"{VIDEO_OUT}/thumb_{ts}.jpg"
    tao_thumbnail_pillow(ten, thumbnail)

    mp4 = f"{VIDEO_OUT}/video_{ts}.mp4"
    ghep_video(thumbnail, mp3, mp4, ten, bio)

    meta = {"video_path": mp4, "thumbnail": thumbnail, "tieu_de": ten,
            "caption": f"{ten}\n\n{bio}\n\n#viral #trending #ai #nexus",
            "timestamp": ts}
    with open(f"{VIDEO_OUT}/meta_{ts}.json", "w", encoding="utf-8") as f:
        json.dump(meta, f, ensure_ascii=False, indent=2)

    # ThÃ´ng bÃ¡o Anh Ä‘Äƒng thá»§ cÃ´ng Facebook/TikTok (thÃ¡ng 1â€“2)
    tg(f"""âœ… Video sáºµn sÃ ng: {ten}
ðŸ“ {mp4}
ðŸ“Œ Caption: {ten}
ðŸ”— {bio}
ðŸ‘‰ Anh Ä‘Äƒng Facebook/TikTok qua Buffer nhÃ©!""")
    return mp4

async def chay():
    # Cháº¡y affiliate trÆ°á»›c
    try:
        data = json.load(open("/root/nexus/data/chu_de_hom_nay.json", encoding="utf-8"))
        ds = data.get("chu_de", [])
    except:
        tg("âš ï¸ ChÆ°a cÃ³ danh sÃ¡ch chá»§ Ä‘á». Cháº¡y hermes_viral_realtime.py trÆ°á»›c!")
        return

    # GÃ¡n link affiliate
    for cd in ds:
        tu_khoa = cd.get("tu_khoa_shopee") or cd.get("ten", "")
        cd["affiliate"] = lay_link_affiliate(tu_khoa, cd.get("ten",""))

    cho_lam = [c for c in ds if c.get("do_viral") in ("cao", "trung")][:3]
    tg(f"ðŸš€ HERMES V6 báº¯t Ä‘áº§u lÃ m {len(cho_lam)} video...")

    for cd in cho_lam:
        try:
            await xu_ly_mot_video(cd)
            await asyncio.sleep(2)
        except Exception as e:
            tg(f"âš ï¸ Lá»—i video '{cd.get('ten','?')}': {e}")

if __name__ == "__main__":
    asyncio.run(chay())
```

