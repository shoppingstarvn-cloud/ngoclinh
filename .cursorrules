CACHE_FILE = "/root/nexus/data/affiliate_cache.json"

# â”€â”€â”€ Báº¢NG LINK AFFILIATE THEO DANH Má»¤C â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
# Anh táº¡o link 1 láº§n trÃªn affiliate.shopee.vn vÃ  affiliate.lazada.vn
