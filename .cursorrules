]

def log(msg):
    ts = datetime.now().strftime("%Y-%m-%d %H:%M:%S")
    with open(LOG, "a", encoding="utf-8") as f:
        f.write(f"[{ts}] {msg}\n")
    print(f"[{ts}] {msg}")

def tg(msg):
    try:
        requests.post(f"https://api.telegram.org/bot{TG_TOKEN}/sendMessage",
                      json={"chat_id": TG_CHAT, "text": msg}, timeout=10)
    except: pass

def quet_youtube():
    if not YOUTUBE_KEY:
        log("[WARN] ChÆ°a cÃ³ YOUTUBE_API_KEY")
        return []
    try:
        r = requests.get("https://www.googleapis.com/youtube/v3/videos", params={
            "part": "snippet,statistics", "chart": "mostPopular",
            "regionCode": "VN", "maxResults": 30, "key": YOUTUBE_KEY
        }, timeout=15)
        return [{"tieu_de": v["snippet"]["title"],
                 "views": int(v["statistics"].get("viewCount", 0)),
                 "tags": v["snippet"].get("tags", [])[:3],
                 "nguon": "YouTube"} for v in r.json().get("items", [])]
    except Exception as e:
        log(f"[WARN] YouTube API lá»—i: {e}")
        return []

def quet_google_trends():
    try:
        feed = feedparser.parse(
            "https://trends.google.com/trends/trendingsearches/daily/rss?geo=VN"
        )
        return [{"tieu_de": e.title, "nguon": "Google Trends", "views": 0}
                for e in feed.entries[:20]]
    except Exception as e:
        log(f"[WARN] Google Trends lá»—i: {e}")
        return []

def quet_rss():
    sources = [
        ("https://vnexpress.net/rss/tin-moi-nhat.rss", "VnExpress"),
        ("https://cafebiz.vn/cafebiz.rss", "CafeBiz"),
        ("https://dantri.com.vn/rss/home.rss", "DanTri"),
    ]
    ket_qua = []
    for url, ten in sources:
        try:
            feed = feedparser.parse(url)
            ket_qua += [{"tieu_de": e.title, "nguon": ten, "views": 0}
                        for e in feed.entries[:10]]
        except: pass
    return ket_qua

def chon_voi_claude(tat_ca_viral):
    du_phong = random.sample(CHU_DE_CO_DINH, min(10, len(CHU_DE_CO_DINH)))
    try:
        r = requests.post("https://api.anthropic.com/v1/messages",
            headers={"x-api-key": API_KEY, "anthropic-version": "2023-06-01",
                     "content-type": "application/json"},
            json={"model": "claude-sonnet-4-6", "max_tokens": 1500,
                  "messages": [{"role": "user", "content": f"""
