  -H "Authorization: Bearer $CF_TOKEN" \
  -H "Content-Type: application/json" \
  -d "{\"type\":\"CNAME\",\"name\":\"$SUBDOMAIN\",\"content\":\"cname.vercel-dns.com\",\"ttl\":300,\"proxied\":false}" | \
  python3 -c "import json,sys; d=json.load(sys.stdin); print('âœ… DNS OK' if d.get('success') else f'âŒ {d.get(\"errors\")}')"
