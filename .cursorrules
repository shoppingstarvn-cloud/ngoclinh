### 1.3 â€” Inject Fetch Interceptor (tá»± Ä‘á»™ng báº¯t má»i API)

```javascript
// Paste TOÃ€N Bá»˜ vÃ o F12 â†’ Console â†’ Enter

const origFetch = window.fetch;
const apiLog = [];

window.fetch = async function(...args) {
  const url = typeof args[0] === 'string' ? args[0] : args[0].url;
  const options = args[1] || {};
  let requestBody = null;
  try { requestBody = options.body ? JSON.parse(options.body) : null; } catch(e) {}
  const response = await origFetch.apply(this, args);
  const clone = response.clone();
  let responseBody = null;
  try { responseBody = await clone.json(); } catch(e) {}
  const logEntry = {
    method: options.method || 'GET',
    url, request: requestBody, response: responseBody,
    time: new Date().toISOString()
  };
  apiLog.push(logEntry);
  console.log('ðŸ” API:', logEntry.method, url);
  return response;
};

const origXHR = XMLHttpRequest.prototype.open;
XMLHttpRequest.prototype.open = function(method, url) {
  console.log('ðŸ“¡ XHR:', method, url);
  apiLog.push({ method, url, type: 'XHR' });
  return origXHR.apply(this, arguments);
};

// Sau khi thao tÃ¡c xong:
// console.table(apiLog)
// copy(JSON.stringify(apiLog, null, 2))
```

Sau khi inject:
1. Thao tÃ¡c toÃ n bá»™ chá»©c nÄƒng website
2. `console.table(apiLog)` â†’ xem báº£ng Ä‘áº¹p
3. `copy(JSON.stringify(apiLog, null, 2))` â†’ copy ra clipboard
