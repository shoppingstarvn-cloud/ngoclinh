def dang_youtube(mp4, tieu_de, caption, thumbnail=None):
    """ÄÄƒng YouTube Shorts qua Data API v3"""
    try:
        creds = Credentials.from_authorized_user_file(YT_CREDS_FILE)
        yt = build("youtube", "v3", credentials=creds)
        body = {
            "snippet": {
                "title": tieu_de[:100],
                "description": caption,
                "tags": ["viral", "ai", "trending", "shorts", "nexus"],
                "categoryId": "22"
            },
            "status": {"privacyStatus": "public"}
        }
        media = MediaFileUpload(mp4, chunksize=-1, resumable=True,
                                mimetype="video/mp4")
        req = yt.videos().insert(part="snippet,status", body=body, media_body=media)
        resp = None
        while resp is None:
            _, resp = req.next_chunk()
        yt_id = resp.get("id", "")

        # Upload thumbnail
        if thumbnail and yt_id:
            try:
                yt.thumbnails().set(videoId=yt_id,
                    media_body=MediaFileUpload(thumbnail, mimetype="image/jpeg")).execute()
            except: pass

        return yt_id
    except Exception as e:
        tg(f"âš ï¸ Lá»—i Ä‘Äƒng YouTube: {e}")
        return None

def dang_mot_video(meta_file):
    log_data = doc_log()
    with open(meta_file, encoding="utf-8") as f:
        meta = json.load(f)

    ts_key = str(meta["timestamp"])
    if log_data.get(ts_key, {}).get("youtube"):
        return  # ÄÃ£ Ä‘Äƒng rá»“i

    mp4       = meta["video_path"]
    tieu_de   = meta["tieu_de"]
    caption   = meta["caption"]
    thumbnail = meta.get("thumbnail")

    if not os.path.exists(mp4):
        tg(f"âš ï¸ File khÃ´ng tá»“n táº¡i: {mp4}")
        return

    tg(f"ðŸ“¤ Äang Ä‘Äƒng YouTube: {tieu_de}")
    yt_id = dang_youtube(mp4, tieu_de, caption, thumbnail)

    if ts_key not in log_data:
        log_data[ts_key] = {}
    log_data[ts_key]["youtube"] = yt_id or "error"
    log_data[ts_key]["tieu_de"] = tieu_de
    log_data[ts_key]["ngay"] = datetime.now().isoformat()
    luu_log(log_data)

    if yt_id:
        tg(f"""âœ… ÄÃ£ Ä‘Äƒng YouTube!
ðŸŽ¬ {tieu_de}
ðŸ”— https://youtube.com/shorts/{yt_id}
ðŸ“Œ Caption Ä‘Ã£ gáº¯n link affiliate
ðŸ‘‰ Anh nhá»› Ä‘Äƒng Facebook + TikTok qua Buffer nhÃ©!""")
    else:
        tg(f"âŒ Lá»—i Ä‘Äƒng YouTube: {tieu_de} â€” Kiá»ƒm tra YouTube credentials!")

def chay():
    tg("ðŸ“¤ HERMES V6 báº¯t Ä‘áº§u Ä‘Äƒng YouTube...")
    log_data = doc_log()
    meta_files = sorted(glob.glob(f"{VIDEO_OUT}/meta_*.json"))

    chua_dang = [f for f in meta_files
                 if not log_data.get(str(json.load(open(f))["timestamp"]), {}).get("youtube")]

    if not chua_dang:
        tg("ðŸ“­ KhÃ´ng cÃ³ video má»›i cáº§n Ä‘Äƒng YouTube.")
        return

    tg(f"ðŸ“¤ HERMES Ä‘Äƒng {len(chua_dang[:3])} video lÃªn YouTube...")
    for mf in chua_dang[:3]:
        dang_mot_video(mf)
        time.sleep(30)

if __name__ == "__main__":
    chay()
```

