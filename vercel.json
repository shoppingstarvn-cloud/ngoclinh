{
  "version": 2,
  "buildCommand": null,
  "outputDirectory": ".",
  "public": true,
  "functions": {
    "api/upload.js": {
      "memory": 256,
      "maxDuration": 30
    }
  },
  "routes": [
    { "src": "^/$", "dest": "/betongphuongbac.com/index.html" },
    { "src": "^/api/upload$", "dest": "/api/upload.js" },
    { "src": "^/superadmin\\.html$", "dest": "/superadmin.html" },
    { "src": "^/uploads/(.*)$", "dest": "/uploads/$1" },
    { "src": "^/(.*\\.(css|js|jpg|jpeg|png|gif|webp|svg|ico|woff|woff2|ttf|eot|json|xml|txt))$", "dest": "/betongphuongbac.com/$1" },
    { "src": "^/(.*\\.html)$", "dest": "/betongphuongbac.com/$1" },
    { "src": "^/([^/.]+)$", "dest": "/betongphuongbac.com/$1.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    },
    {
      "source": "/(.*\\.(jpg|jpeg|png|gif|webp|svg|ico|css|js|woff|woff2))",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ],
  "github": {
    "silent": true,
    "autoJobCancelation": true
  }
}