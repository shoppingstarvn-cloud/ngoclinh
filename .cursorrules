### 2.4 BÆ°á»›c 4 â€” Copy vÃ  táº¡o sheets má»›i

```python
from copy import copy
from openpyxl.utils import get_column_letter
from openpyxl.styles import Font, PatternFill, Alignment, Border, Side
import copy as copy_module

def copy_sheet(wb, src_name, dst_name):
    """Copy toÃ n bá»™ sheet (values + formulas + formatting) sang sheet má»›i"""
    src = wb[src_name]
    dst = wb.copy_worksheet(src)
    dst.title = dst_name
    return dst

def create_month_sheets(wb, new_month, new_year, 
                         template_month, template_year,
                         new_classes=None,       # [(name, sessions, fee), ...]
                         delete_classes=None,    # [class_name, ...]
                         new_expenses=None,      # [(name, amount), ...]
                         delete_expenses=None):  # [expense_name, ...]
    """
    Táº¡o 3 sheets má»›i cho thÃ¡ng new_month/new_year
    báº±ng cÃ¡ch copy tá»« template thÃ¡ng template_month/template_year
    """
    # TÃªn sheet template
    t_chi = f'Báº¢NG CHI Äá»ŠNH KÃŒ THÃNG {template_month}.{template_year}'
    t_thu = f'Báº¢NG Tá»”NG THU THÃNG {template_month}.{template_year}'
    t_cl  = f'Báº¢NG CHIáº¾N LÆ¯á»¢C CHI {template_month}.{template_year}'
    
    # TÃªn sheet má»›i
    n_chi = f'Báº¢NG CHI Äá»ŠNH KÃŒ THÃNG {new_month}.{new_year}'
    n_thu = f'Báº¢NG Tá»”NG THU THÃNG {new_month}.{new_year}'
    n_cl  = f'Báº¢NG CHIáº¾N LÆ¯á»¢C CHI {new_month}.{new_year}'
    
    # Kiá»ƒm tra template tá»“n táº¡i
    # Náº¿u template cÃ³ dáº¥u cÃ¡ch thá»«a (nhÆ° '5.2026 '), tÃ¬m gáº§n Ä‘Ãºng
    for s in wb.sheetnames:
        if s.strip() == t_chi.strip(): t_chi = s; break
    for s in wb.sheetnames:
        if s.strip() == t_thu.strip(): t_thu = s; break  
    for s in wb.sheetnames:
        if s.strip() == t_cl.strip(): t_cl = s; break

    # Copy 3 sheets (thÃªm vÃ o cuá»‘i)
    ws_chi = copy_sheet(wb, t_chi, n_chi)
    ws_thu = copy_sheet(wb, t_thu, n_thu)
    ws_cl  = copy_sheet(wb, t_cl, n_cl)
    
    # --- Cáº­p nháº­t Báº¢NG Tá»”NG THU ---
    # Reset cá»™t D (thá»±c táº¿) vá» 0 cho táº¥t cáº£ lá»›p
    for row in ws_thu.iter_rows(min_row=7, max_row=ws_thu.max_row):
        for cell in row:
            if cell.column == 4 and isinstance(cell.value, (int, float)):  # cá»™t D
                cell.value = 0
    
    # XÃ³a lá»›p nghá»‰
    if delete_classes:
        rows_to_delete = []
        for row in ws_thu.iter_rows(min_row=7, max_row=ws_thu.max_row):
            b_cell = row[1]  # cá»™t B
            if b_cell.value and any(dc.lower() in str(b_cell.value).lower() 
                                     for dc in (delete_classes or [])):
                rows_to_delete.append(row[0].row)
        for r in reversed(rows_to_delete):
            ws_thu.delete_rows(r)
    
    # ThÃªm lá»›p má»›i vÃ o cuá»‘i danh sÃ¡ch (trÆ°á»›c hÃ ng Tá»”NG)
    if new_classes:
        # TÃ¬m hÃ ng Tá»”NG cuá»‘i
        insert_before = ws_thu.max_row - 3  # Æ°á»›c lÆ°á»£ng
        for i, row in enumerate(ws_thu.iter_rows(min_row=7, max_row=ws_thu.max_row)):
            if row[0].value and str(row[0].value).lower() in ['tá»•ng', 'tong']:
                insert_before = row[0].row
                break
        
        for cls_name, sessions, fee in (new_classes or []):
            # Insert row trÆ°á»›c hÃ ng tá»•ng
            ws_thu.insert_rows(insert_before)
            r = insert_before
            ws_thu[f'B{r}'] = cls_name
            ws_thu[f'C{r}'] = sessions
            ws_thu[f'D{r}'] = 0
            ws_thu[f'E{r}'] = fee
            ws_thu[f'F{r}'] = f'=C{r}*E{r}'
            ws_thu[f'G{r}'] = f'=D{r}*E{r}'
            ws_thu[f'K{r}'] = f'=H{r}-J{r}'
            ws_thu[f'L{r}'] = f'=G{r}-J{r}'
            ws_thu[f'M{r}'] = f'=G{r}-H{r}'
            insert_before += 1

    # --- Cáº­p nháº­t Báº¢NG CHI Äá»ŠNH KÃŒ ---
    # XÃ³a khoáº£n chi nghá»‰
    if delete_expenses:
        rows_to_delete = []
        for row in ws_chi.iter_rows(min_row=8, max_row=ws_chi.max_row):
            b_cell = row[1]  # cá»™t B
            if b_cell.value and any(de.lower() in str(b_cell.value).lower()
                                     for de in (delete_expenses or [])):
                rows_to_delete.append(row[0].row)
        for r in reversed(rows_to_delete):
            ws_chi.delete_rows(r)
    
    # ThÃªm khoáº£n chi má»›i (trÆ°á»›c hÃ ng Tá»”NG)
    if new_expenses:
        # TÃ¬m hÃ ng tá»•ng trong chi Ä‘á»‹nh ká»³ (cÃ³ SUM á»Ÿ cá»™t C)
        insert_before_chi = 23  # default
        for row in ws_chi.iter_rows(min_row=8, max_row=ws_chi.max_row):
            c_cell = row[2]  # cá»™t C
            if c_cell.value and isinstance(c_cell.value, str) and '=SUM' in c_cell.value:
                insert_before_chi = row[0].row
                break
        
        for exp_name, exp_amount in (new_expenses or []):
            ws_chi.insert_rows(insert_before_chi)
            r = insert_before_chi
            ws_chi[f'B{r}'] = exp_name
            ws_chi[f'C{r}'] = exp_amount
            ws_chi[f'AI{r}'] = f'=SUM(D{r}:AH{r})'
            ws_chi[f'AJ{r}'] = f'=C{r}-AI{r}'
            insert_before_chi += 1
    
    # --- Cáº­p nháº­t Báº¢NG CHIáº¾N LÆ¯á»¢C CHI ---
    # XÃ³a data cÅ© tá»« hÃ ng 7 Ä‘áº¿n hÃ ng cÃ³ dá»¯ liá»‡u (giá»¯ headers)
    # Chá»‰ clear cÃ¡c cá»™t D (Dá»± Ä‘á»‹nh chi), E (Thá»±c chi), G (ghi chÃº thá»±c)
    for row in ws_cl.iter_rows(min_row=7, max_row=ws_cl.max_row):
        for cell in row:
            if cell.column in [4, 5, 7]:  # D, E, G
                cell.value = 0
    # Cáº­p nháº­t thÃ¡ng/nÄƒm trong header
    ws_cl['C4'] = new_month
    ws_cl['H4'] = new_year
    
    return ws_chi, ws_thu, ws_cl
```

### 2.5 BÆ°á»›c 5 â€” ThÃªm nhiá»u thÃ¡ng liÃªn tiáº¿p

```python
def add_months_range(wb, from_month, from_year, to_month, to_year,
                     month_config=None):
    """
    ThÃªm táº¥t cáº£ thÃ¡ng tá»« (from_month/from_year)+1 Ä‘áº¿n to_month/to_year
    month_config: dict {(month, year): {new_classes, delete_classes, new_expenses, delete_expenses}}
    """
    current_m, current_y = from_month, from_year
    template_m, template_y = from_month, from_year
    
    created = []
    while True:
        # TÃ­nh thÃ¡ng tiáº¿p theo
        next_m = current_m + 1
        next_y = current_y
        if next_m > 12:
            next_m = 1
            next_y += 1
        
        if (next_y, next_m) > (to_year, to_month):
            break
        
        config = (month_config or {}).get((next_m, next_y), {})
        create_month_sheets(
            wb, next_m, next_y, template_m, template_y,
            new_classes=config.get('new_classes'),
            delete_classes=config.get('delete_classes'),
            new_expenses=config.get('new_expenses'),
            delete_expenses=config.get('delete_expenses')
        )
        created.append((next_m, next_y))
        template_m, template_y = next_m, next_y
        current_m, current_y = next_m, next_y
    
    return created
```

