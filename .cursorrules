        "lazada": os.getenv("LAZADA_AFFILIATE_URL_DEFAULT", "https://www.lazada.vn/"),
        "ten": "Sáº£n pháº©m hot hÃ´m nay"
    }
}

KEYWORD_MAPPING = {
    "mÃ¨o": "thÃº cÆ°ng", "chÃ³": "thÃº cÆ°ng", "Ä‘á»™ng váº­t": "thÃº cÆ°ng",
    "robot": "cÃ´ng nghá»‡", "ai": "cÃ´ng nghá»‡", "gadget": "cÃ´ng nghá»‡",
    "cÃ´ng nghá»‡": "cÃ´ng nghá»‡", "Ä‘iá»‡n thoáº¡i": "cÃ´ng nghá»‡", "tai nghe": "cÃ´ng nghá»‡",
    "Ä‘á»“ Äƒn": "Ä‘á»“ Äƒn", "áº©m thá»±c": "Ä‘á»“ Äƒn", "review Äƒn": "Ä‘á»“ Äƒn",
    "ná»“i chiÃªn": "gia dá»¥ng", "gia dá»¥ng": "gia dá»¥ng", "nhÃ ": "gia dá»¥ng",
    "sá»©c khá»e": "sá»©c khá»e", "thá»ƒ thao": "sá»©c khá»e", "gym": "sá»©c khá»e",
}

def chon_danh_muc(tu_khoa: str) -> str:
    tu_khoa_lower = tu_khoa.lower()
    for kw, danh_muc in KEYWORD_MAPPING.items():
        if kw in tu_khoa_lower:
            return danh_muc
    return "default"

def lay_link_affiliate(tu_khoa: str, chu_de: str = "") -> dict:
    """
    Láº¥y link affiliate phÃ¹ há»£p theo tá»« khÃ³a
    Tráº£ vá» dict vá»›i shopee_link, lazada_link, ten_san_pham, caption_bio
    """
    cache = {}
    try:
        cache = json.load(open(CACHE_FILE, encoding="utf-8"))
    except: pass

    cache_key = tu_khoa.lower().strip()
    if cache_key in cache:
        if cache[cache_key].get("ngay") == datetime.now().strftime("%Y-%m-%d"):
            return cache[cache_key]

    danh_muc = chon_danh_muc(tu_khoa or chu_de)
    links = AFFILIATE_LINKS.get(danh_muc, AFFILIATE_LINKS["default"])

    ket_qua = {
        "tu_khoa": tu_khoa,
        "chu_de": chu_de,
        "danh_muc": danh_muc,
        "ten_san_pham": links["ten"],
        "shopee_link": links["shopee"],
        "lazada_link": links["lazada"],
        "caption_bio": (
            f"ðŸ›’ {links['ten']}\n"
            f"ðŸ“± Shopee: {links['shopee']}\n"
            f"ðŸ›ï¸ Lazada: {links['lazada']}"
        ),
        "ngay": datetime.now().strftime("%Y-%m-%d")
    }

    cache[cache_key] = ket_qua
    try:
        with open(CACHE_FILE, "w", encoding="utf-8") as f:
            json.dump(cache, f, ensure_ascii=False, indent=2)
    except: pass

    return ket_qua

def lay_link_cho_tat_ca_chu_de():
    """Äá»c danh sÃ¡ch chá»§ Ä‘á» hÃ´m nay, gÃ¡n link affiliate phÃ¹ há»£p"""
    try:
        data = json.load(open("/root/nexus/data/chu_de_hom_nay.json", encoding="utf-8"))
        ds = data.get("chu_de", [])
    except:
        print("ChÆ°a cÃ³ file chu_de_hom_nay.json. Cháº¡y hermes_viral_realtime.py trÆ°á»›c.")
        return []

    for cd in ds:
        tu_khoa = cd.get("tu_khoa_shopee") or cd.get("ten", "")
        cd["affiliate"] = lay_link_affiliate(tu_khoa, cd.get("ten", ""))
        print(f"  âœ… GÃ¡n link affiliate: {tu_khoa} â†’ {cd['affiliate']['danh_muc']}")

    data["chu_de"] = ds
    with open("/root/nexus/data/chu_de_hom_nay.json", "w", encoding="utf-8") as f:
        json.dump(data, f, ensure_ascii=False, indent=2)

    print(f"âœ… ÄÃ£ gÃ¡n link affiliate cho {len(ds)} chá»§ Ä‘á»!")
    return ds

if __name__ == "__main__":
    import sys
    if len(sys.argv) > 1:
        tu_khoa = " ".join(sys.argv[1:])
        link = lay_link_affiliate(tu_khoa)
        print(json.dumps(link, ensure_ascii=False, indent=2))
    else:
        lay_link_cho_tat_ca_chu_de()
