{
  "version": 2,
  "buildCommand": null,
  "outputDirectory": ".",
  "functions": {
    "api/upload.js": {
      "memory": 256,
      "maxDuration": 30
    }
  },
  "routes": [
    { "src": "/api/upload", "dest": "/api/upload.js" },
    { "src": "/superadmin.html", "dest": "/superadmin.html" },
    { "src": "/index.html", "dest": "/betongphuongbac.com/index.html" },
    { "src": "/css/(.*)", "dest": "/betongphuongbac.com/css/$1" },
    { "src": "/images/(.*)", "dest": "/betongphuongbac.com/images/$1" },
    { "src": "/assets/(.*)", "dest": "/betongphuongbac.com/assets/$1" },
    { "src": "/font/(.*)", "dest": "/betongphuongbac.com/font/$1" },
    { "src": "/hpm/(.*)", "dest": "/betongphuongbac.com/hpm/$1" },
    { "src": "/", "dest": "/betongphuongbac.com/index.html" },
    { "src": "/(.*)", "dest": "/betongphuongbac.com/$1" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    },
    {
      "source": "/(.*\\.(jpg|jpeg|png|gif|webp|svg|ico|css|js|woff|woff2))",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ],
  "github": {
    "silent": true,
    "autoJobCancelation": true
  }
}