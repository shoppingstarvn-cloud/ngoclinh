### SCRIPT 5: hermes_evolution_v6.py
**Chá»©c nÄƒng:** HERMES tá»± há»c vÃ  tiáº¿n hÃ³a (khÃ´ng thay Ä‘á»•i so vá»›i V5 â€” script nÃ y á»•n)

```python
#!/usr/bin/env python3
# hermes_evolution_v6.py â€” 4 táº§ng tá»± há»c (giá»¯ nguyÃªn logic V5, sá»­a tÃªn)
# python3 hermes_evolution_v6.py [daily|weekly|monthly]

import sqlite3, json, requests, os, sys
from datetime import datetime

API_KEY  = os.getenv("ANTHROPIC_API_KEY")
TG_TOKEN = os.getenv("TELEGRAM_BOT_TOKEN")
TG_CHAT  = os.getenv("TELEGRAM_CHAT_ID")
DB       = "/root/nexus/data/hermes_brain.db"

def init_db():
    conn = sqlite3.connect(DB)
    conn.executescript("""
        CREATE TABLE IF NOT EXISTS video_results (
            id INTEGER PRIMARY KEY, chu_de TEXT, nhom TEXT, hook_3s TEXT,
            views_24h INTEGER DEFAULT 0, views_7d INTEGER DEFAULT 0,
            ctr REAL DEFAULT 0, doanh_thu INTEGER DEFAULT 0,
            ngay_dang TEXT, yt_id TEXT
        );
        CREATE TABLE IF NOT EXISTS pattern_weights (
            pattern TEXT PRIMARY KEY, trong_so REAL DEFAULT 0.5, cap_nhat TEXT
        );
        CREATE TABLE IF NOT EXISTS prompt_evolution (
            phien_ban INTEGER PRIMARY KEY, noi_dung TEXT,
            diem REAL DEFAULT 0, ngay TEXT
        );
        CREATE TABLE IF NOT EXISTS chi_phi_log (
            id INTEGER PRIMARY KEY, thang TEXT,
            api_tokens INTEGER DEFAULT 0, chi_phi_usd REAL DEFAULT 0,
            doanh_thu_vnd INTEGER DEFAULT 0, ngay TEXT
        );
    """)
    conn.commit(); conn.close()

def claude(prompt, max_tokens=1000):
    r = requests.post("https://api.anthropic.com/v1/messages",
        headers={"x-api-key": API_KEY, "anthropic-version": "2023-06-01",
                 "content-type": "application/json"},
        json={"model": "claude-sonnet-4-6", "max_tokens": max_tokens,
              "messages": [{"role": "user", "content": prompt}]}, timeout=30)
    return r.json()["content"][0]["text"]

def tg(msg):
    try:
        requests.post(f"https://api.telegram.org/bot{TG_TOKEN}/sendMessage",
                      json={"chat_id": TG_CHAT, "text": msg}, timeout=10)
    except: pass

def phan_tich_ngay():
    """Táº§ng 1+2: Ghi nhá»› + PhÃ¢n tÃ­ch hiá»‡u suáº¥t (23:00 hÃ ng ngÃ y)"""
    conn = sqlite3.connect(DB)
    rows = conn.execute("""
        SELECT chu_de, nhom, hook_3s, views_7d, ctr, doanh_thu FROM video_results
        WHERE ngay_dang >= date('now','-7 days') ORDER BY doanh_thu DESC LIMIT 20
    """).fetchall()
    tong_dt = conn.execute(
        "SELECT SUM(doanh_thu) FROM video_results WHERE ngay_dang >= date('now','-30 days')"
    ).fetchone()[0] or 0
    tong_video = conn.execute(
        "SELECT COUNT(*) FROM video_results WHERE ngay_dang >= date('now','-7 days')"
    ).fetchone()[0]
    conn.close()

    if not rows:
        tg("ðŸ§¬ HERMES: ChÆ°a cÃ³ dá»¯ liá»‡u video. Cáº§n cháº¡y pipeline vÃ  log káº¿t quáº£ trÆ°á»›c!")
        return

    data_str = json.dumps([{"chu_de":r[0],"nhom":r[1],"hook":r[2],
                             "views_7d":r[3],"ctr":r[4],"doanh_thu":r[5]}
                            for r in rows], ensure_ascii=False)
    out = claude(f"""PhÃ¢n tÃ­ch káº¿t quáº£ 7 ngÃ y cá»§a HERMES:
{data_str}
Tá»•ng doanh thu 30 ngÃ y: {tong_dt:,}Ä‘ | Tá»•ng video 7 ngÃ y: {tong_video}

Tráº£ vá» JSON:
{{"suc_khoe":8.5,"video_tot":"...","nhom_tot":"...","pattern_thanh_cong":["..."],"bai_hoc":["..."],"canh_bao":"...","tom_tat":"(1 dÃ²ng ngáº¯n)"}}""")
    try:
        d = json.loads(out)
        tg(f"""ðŸ§¬ HERMES â€” BÃO CÃO NGÃ€Y {datetime.now().strftime('%d/%m/%Y')}
ðŸ“Š Sá»©c khá»e há»‡ thá»‘ng: {d.get('suc_khoe','?')}/10
ðŸ† Video tá»‘t nháº¥t: {d.get('video_tot','?')}
ðŸŽ¯ NhÃ³m hiá»‡u quáº£ nháº¥t: {d.get('nhom_tot','?')}
ðŸ’° Doanh thu 30 ngÃ y: {tong_dt:,}Ä‘
âš ï¸ Cáº£nh bÃ¡o: {d.get('canh_bao','KhÃ´ng cÃ³')}
ðŸ’¡ {d.get('tom_tat','?')}
ðŸ“š BÃ i há»c: {' | '.join(d.get('bai_hoc',[])[:2])}""")
    except:
        tg(f"ðŸ§¬ HERMES há»c há»i xong! Doanh thu 30 ngÃ y: {tong_dt:,}Ä‘")

def nang_cap_thuat_toan():
    """Táº§ng 3: Tá»‘i Æ°u trá»ng sá»‘ theo nhÃ³m chá»§ Ä‘á» (Chá»§ nháº­t 08:00)"""
    conn = sqlite3.connect(DB)
    rows = conn.execute("""
        SELECT nhom, SUM(doanh_thu) as tong, AVG(ctr) as avg_ctr, COUNT(*) as so_video
        FROM video_results WHERE ngay_dang >= date('now','-30 days')
        GROUP BY nhom ORDER BY tong DESC
    """).fetchall()
    conn.close()

    if not rows:
        tg("âš¡ ChÆ°a Ä‘á»§ dá»¯ liá»‡u Ä‘á»ƒ nÃ¢ng cáº¥p thuáº­t toÃ¡n.")
        return

    total = sum(r[1] for r in rows) or 1
    ws = {r[0]: {"trong_so": round(r[1]/total, 3), "avg_ctr": round(r[2] or 0, 3),
                  "so_video": r[3]} for r in rows}

    with open("/root/nexus/data/hermes_weights.json", "w") as f:
        json.dump({"cap_nhat": datetime.now().isoformat(), "trong_so_nhom": ws},
                  f, ensure_ascii=False, indent=2)

    top3 = list(ws.keys())[:3]
    tg(f"""âš¡ HERMES nÃ¢ng cáº¥p thuáº­t toÃ¡n!
ðŸ“Š {len(ws)} nhÃ³m Ä‘Æ°á»£c cÃ¢n chá»‰nh
ðŸ† Top 3 nhÃ³m: {', '.join(top3)}
â†’ Tuáº§n sau HERMES Æ°u tiÃªn cÃ¡c nhÃ³m nÃ y!""")

def tien_hoa_prompt():
    """Táº§ng 4: Tá»± viáº¿t láº¡i prompt tá»‘t hÆ¡n má»—i thÃ¡ng"""
    conn = sqlite3.connect(DB)
    cu = conn.execute(
        "SELECT noi_dung, phien_ban FROM prompt_evolution ORDER BY phien_ban DESC LIMIT 1"
    ).fetchone()
    top = conn.execute("""
        SELECT chu_de, hook_3s, nhom, views_7d, doanh_thu FROM video_results
        WHERE ngay_dang >= date('now','-30 days') ORDER BY doanh_thu DESC LIMIT 30
    """).fetchall()
    conn.close()

    pv = (cu[1] if cu else 0) + 1
    out = claude(f"""Anh lÃ  HERMES V{pv} â€” AI tá»± tiáº¿n hÃ³a.
Prompt hiá»‡n táº¡i (V{pv-1}): {cu[0] if cu else 'ChÆ°a cÃ³'}

Top 30 video hiá»‡u quáº£ nháº¥t:
{json.dumps([{"chu_de":r[0],"hook":r[1],"nhom":r[2],"views":r[3],"dt":r[4]}
             for r in top], ensure_ascii=False)}

PhÃ¢n tÃ­ch pattern vÃ  viáº¿t prompt Má»šI tá»‘t hÆ¡n.
Tráº£ vá» JSON:
{{"phan_tich":"...","tang_hieu_qua":"+X%","diem_yeu_cu":"...","prompt_moi":"...","ly_do":["..."]}}""", 1500)
    try:
        d = json.loads(out)
        conn = sqlite3.connect(DB)
        conn.execute("INSERT INTO prompt_evolution (phien_ban,noi_dung,ngay) VALUES (?,?,?)",
                     (pv, d["prompt_moi"], datetime.now().isoformat()))
        conn.commit(); conn.close()
        tg(f"""ðŸ† HERMES TIáº¾N HÃ“A â†’ Prompt V{pv}!
ðŸ“ˆ Dá»± kiáº¿n tÄƒng: {d.get('tang_hieu_qua','?')}
ðŸ” Äiá»ƒm yáº¿u Ä‘Ã£ sá»­a: {d.get('diem_yeu_cu','?')}""")
    except:
        tg(f"ðŸ† HERMES hoÃ n táº¥t tiáº¿n hÃ³a Prompt V{pv}!")

if __name__ == "__main__":
    init_db()
    cmd = sys.argv[1] if len(sys.argv) > 1 else "daily"
    {"daily": phan_tich_ngay,
     "weekly": nang_cap_thuat_toan,
     "monthly": tien_hoa_prompt}.get(cmd, phan_tich_ngay)()
```

