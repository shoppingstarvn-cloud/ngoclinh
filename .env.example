# ============================================================
# BIẾN MÔI TRƯỜNG — webbetonglammau (Next.js App Router)
# Copy file này thành .env.local (local) và khai báo trên Vercel
# Project Settings → Environment Variables (production/preview).
# ============================================================

# Supabase — công khai (an toàn khi lộ ra client, bị RLS bảo vệ)
NEXT_PUBLIC_SUPABASE_URL=https://bfruxinvvvaqufghtigw.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_QUYv4qEJntioJJ-XWtHkdA_haHovSml

# Supabase — BÍ MẬT, chỉ dùng server-side (route handlers). KHÔNG thêm
# tiền tố NEXT_PUBLIC_. Lấy tại Supabase Dashboard → Project Settings → API
# → service_role (secret), bắt đầu bằng "eyJ..." hoặc "sb_secret_...".
SUPABASE_SERVICE_KEY=your_service_role_key_here
SUPABASE_BUCKET=uploads

# Auth admin — khoá ký JWT (HS256). Đổi giá trị ngẫu nhiên đủ mạnh khi lên production.
JWT_SECRET=cuaau-superadmin-secret-2026

# URL công khai của site (dùng cho metadataBase, canonical, sitemap...)
NEXT_PUBLIC_SITE_URL=https://webbetonglammau.vercel.app
