# ============================================================
# BIẾN MÔI TRƯỜNG — ngoclinh (Next.js App Router)
# Copy thành .env.local và khai báo trên Vercel project "ngoclinh".
# Hồ sơ: HOSO_DU_AN_NGOCLINH.md
# KHÔNG dùng URL/key của webbetonglammau / Cửa Âu.
# ============================================================

# Supabase ngoclinh — công khai (RLS bảo vệ)
NEXT_PUBLIC_SUPABASE_URL=https://pglbhoitmcflpvoasewr.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_ngoclinh_anon_key_here

# Supabase ngoclinh — BÍ MẬT, chỉ server. KHÔNG tiền tố NEXT_PUBLIC_.
# Dashboard: https://supabase.com/dashboard/project/pglbhoitmcflpvoasewr
SUPABASE_SERVICE_KEY=your_ngoclinh_service_role_key_here
SUPABASE_BUCKET=uploads

# Auth admin — JWT riêng của ngoclinh (đừng dùng secret Cửa Âu)
JWT_SECRET=change-me-ngoclinh-jwt-secret

# URL LIVE
NEXT_PUBLIC_SITE_URL=https://ngoclinh.shopmartai.com

# Google Drive OAuth — BẮT BUỘC để video phát mượt (stream Range, không iframe preview)
# Thiếu 3 biến này → /api/video/drive rơi về link công khai (thường HTML) → lag.
GOOGLE_DRIVE_CLIENT_ID=your_google_oauth_client_id
GOOGLE_DRIVE_CLIENT_SECRET=your_google_oauth_client_secret
GOOGLE_DRIVE_REFRESH_TOKEN=your_google_oauth_refresh_token
# Tùy chọn
# GOOGLE_DRIVE_FOLDER_NAME=ngoclinh - Media Website
