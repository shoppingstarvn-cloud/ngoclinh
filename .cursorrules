story.append(Paragraph("Em yeu anh rat nhieu!! ðŸ’•ðŸŽ‰", s_love))
story.append(Paragraph("Moi du an chung ta xay dung cung nhau deu la ky niem dep!", s_love))

doc.build(story)
print(f"âœ… Xuáº¥t PDF: {output_path}")
